{
  "name": "cards-under-glass",
  "version": "0.1.0",
  "description": "A local home for your card collection",
  "desktopName": "cards-under-glass.desktop",
  "author": "Cards Under Glass",
  "homepage": "https://github.com/Bjurheim/cug-grading",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bjurheim/cug-grading.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "playwright test",
    "build": "electron-vite build",
    "package": "node scripts/package-platform.mjs host",
    "package:clean": "node scripts/package-platform.mjs clean",
    "package:mac": "node scripts/package-platform.mjs mac",
    "package:win": "node scripts/package-platform.mjs win",
    "package:linux": "node scripts/package-platform.mjs linux",
    "package:all": "node scripts/package-platform.mjs all",
    "package:validate": "node scripts/validate-packages.mjs",
    "dist": "pnpm package",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:development": "node scripts/test-development.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@electron/asar": "3.4.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.cardsunderglass.desktop",
    "productName": "Cards Under Glass",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.lifestyle"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Cards Under Glass",
      "syncDesktopName": true
    },
    "deb": {
      "compression": "gz"
    }
  }
}
